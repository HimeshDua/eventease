rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function currentUser() { return get(userPath(request.auth.uid)).data; }
    function activeUser() { return signedIn() && currentUser().active == true; }
    function isAdmin() { return activeUser() && currentUser().role == 'admin'; }
    function isOrganizer() { return activeUser() && currentUser().role == 'organizer'; }
    function ownsEvent(eventId) {
      return signedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }
    function hasOnlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys)
        && request.resource.data.diff(resource.data).affectedKeys().size() > 0;
    }
    function eventExists(eventId) { return exists(/databases/$(database)/documents/events/$(eventId)); }
    function getEvent(eventId) { return get(/databases/$(database)/documents/events/$(eventId)).data; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'attendee'
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin() && (
        request.auth.uid != userId
        || (request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active)
      ) || (
        request.auth.uid == userId
        && hasOnlyChanged(['name', 'phone', 'profileImageUrl', 'organizerRequested', 'remindersEnabled', 'fcmTokens'])
        && request.resource.data.email == resource.data.email
      );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn() && (
        isAdmin() || resource.data.organizerId == request.auth.uid || resource.data.status == 'approved'
        || exists(/databases/$(database)/documents/registrations/$(request.auth.uid + '_' + eventId))
      );
      allow create: if (isOrganizer() || isAdmin())
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.registeredCount == 0
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update: if isAdmin() || (
        isOrganizer()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.registeredCount == resource.data.registeredCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.maxParticipants >= resource.data.registeredCount
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'approved'
              && request.resource.data.status == 'pending'
              && request.resource.data.changeReviewPending == true)
        )
      ) || (
        activeUser() && hasOnlyChanged(['registeredCount'])
        && (request.resource.data.registeredCount == resource.data.registeredCount + 1
          || request.resource.data.registeredCount == resource.data.registeredCount - 1)
      );
      allow delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin() || ownsEvent(resource.data.eventId)
      );
      allow create: if activeUser()
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'registered'
        && eventExists(request.resource.data.eventId)
        && getEvent(request.resource.data.eventId).status == 'approved'
        && getEvent(request.resource.data.eventId).startTime > request.time
        && getEvent(request.resource.data.eventId).registeredCount < getEvent(request.resource.data.eventId).maxParticipants;
      allow update: if (
        request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.status == 'cancelled'
        && resource.data.status == 'registered'
      ) || (
        (isAdmin() || ownsEvent(resource.data.eventId))
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.status == 'attended'
        && resource.data.status == 'registered'
      ) || (
        request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.status == 'registered'
        && resource.data.status == 'cancelled'
      );
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (
        resource.data == null
        || resource.data.userId == request.auth.uid
        || isAdmin()
        || ownsEvent(resource.data.eventId)
      );
      allow create: if (isAdmin() || ownsEvent(request.resource.data.eventId))
        && attendanceId == request.resource.data.userId + '_' + request.resource.data.eventId
        && exists(/databases/$(database)/documents/registrations/$(attendanceId))
        && get(/databases/$(database)/documents/registrations/$(attendanceId)).data.userId == request.resource.data.userId
        && get(/databases/$(database)/documents/registrations/$(attendanceId)).data.eventId == request.resource.data.eventId
        && get(/databases/$(database)/documents/registrations/$(attendanceId)).data.status == 'registered'
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.organizerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && favoriteId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.userId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || ownsEvent(resource.data.eventId)
      );
      allow create: if activeUser()
        && feedbackId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/registrations/$(feedbackId))
        && get(/databases/$(database)/documents/registrations/$(feedbackId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/registrations/$(feedbackId)).data.eventId == request.resource.data.eventId
        && get(/databases/$(database)/documents/registrations/$(feedbackId)).data.status == 'attended';
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
        || (request.resource.data.eventId != null && ownsEvent(request.resource.data.eventId))
      );
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && hasOnlyChanged(['isRead']);
      allow delete: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if signedIn();
      allow create: if (isAdmin() || ownsEvent(request.resource.data.eventId))
        && eventExists(request.resource.data.eventId)
        && (getEvent(request.resource.data.eventId).status == 'completed'
            || getEvent(request.resource.data.eventId).endTime <= request.time);
      allow delete: if isAdmin() || ownsEvent(request.resource.data.eventId);
    }

    match /contactMessages/{messageId} {
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
